{
  "name": "cippi-cam",
  "version": "0.13.0",
  "private": true,
  "type": "module",
  "scripts": {
    "classify": "tsx src/comandi/classify.ts",
    "db:up": "docker compose up -d",
    "db:psql": "docker compose exec db psql -U cippi cippi",
    "cerca": "tsx src/comandi/cerca.ts",
    "confronta-embedding": "tsx src/comandi/confronta-embedding.ts",
    "importa": "tsx src/comandi/importa.ts",
    "server": "tsx watch src/server/index.ts",
    "valuta": "tsx src/comandi/valuta.ts",
    "scatta": "caffeinate -di tsx src/comandi/scatta.ts",
    "chiedi": "tsx src/comandi/chiedi.ts",
    "db:migra": "for f in db/migrazioni/*.sql; do echo \"→ $f\"; docker compose exec -T db psql -q -v ON_ERROR_STOP=1 -U cippi cippi < \"$f\" || exit 1; done",
    "dev": "node scripts/dev.mjs",
    "embedding-immagini": "tsx src/comandi/embedding-immagini.ts",
    "clip-zero-shot": "tsx src/comandi/clip-zero-shot.ts",
    "classificatore": "tsx src/comandi/classificatore.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "@huggingface/transformers": "^4.3.1",
    "@langchain/aws": "^1.4.6",
    "@langchain/core": "^1.2.17",
    "@langchain/langgraph": "^1.5.0",
    "@langchain/ollama": "^1.3.0",
    "exifr": "^7.1.3",
    "hono": "^4.13.13",
    "langchain": "^1.5.16",
    "pg": "^8.23.1",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.23.1",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}

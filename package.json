{
  "name": "cippi-cam",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "classify": "tsx src/classify.ts",
    "db:up": "docker compose up -d",
    "db:psql": "docker compose exec db psql -U cippi cippi",
    "cerca": "tsx src/cerca.ts",
    "confronta-embedding": "tsx src/confronta-embedding.ts",
    "importa": "tsx src/importa.ts",
    "server": "tsx watch src/server.ts",
    "valuta": "tsx src/valuta.ts",
    "scatta": "caffeinate -di tsx src/scatta.ts",
    "chiedi": "tsx src/chiedi.ts",
    "db:migra": "for f in db/migrazioni/*.sql; do echo \"→ $f\"; docker compose exec -T db psql -q -v ON_ERROR_STOP=1 -U cippi cippi < \"$f\" || exit 1; done",
    "dev": "node scripts/dev.mjs"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "exifr": "^7.1.3",
    "hono": "^4.13.13",
    "pg": "^8.23.1",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.23.1",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}

# Configurazione di Cippi Cam. Copia questo file in .env e modifica quello che ti serve.
# Senza .env si usano i valori di default: tutto in locale con Ollama.
# Le variabili impostate nella shell vincono su quelle del file.

# --- Database ---
DATABASE_URL=postgres://cippi:cippi@localhost:5432/cippi

# --- Modelli: quale provider ---
# ollama  → modelli in locale (default)
# bedrock → Amazon Bedrock; le credenziali le trova l'SDK AWS (aws sso login, ~/.aws/credentials, ruolo IAM)
LLM_PROVIDER=ollama

# --- Ollama ---
OLLAMA_URL=http://localhost:11434
VISION_MODEL=qwen3.5:9b
AGENT_MODEL=qwen3.5:9b
EMBED_MODEL=nomic-embed-text
EMBED_DIMENSIONI=768

# --- Bedrock (esempio: decommenta e scegli modelli abilitati sul tuo account e nella tua region) ---
# LLM_PROVIDER=bedrock
# AWS_REGION=eu-central-1
# VISION_MODEL=<id di un modello Bedrock con visione>
# AGENT_MODEL=<id di un modello Bedrock con tool use>
# AGENT_MODEL_RAGIONANTE=<opzionale: un modello più forte per i casi in cui scatta il guardrail>
# EMBED_MODEL=amazon.titan-embed-text-v2:0
# EMBED_DIMENSIONI=1024
# ⚠️ Gli embedding di un altro modello hanno un'altra dimensione e non sono confrontabili con quelli salvati:
#    cambiare EMBED_MODEL richiede una migrazione della colonna embedding_testo e il ricalcolo dei vettori.

# --- Debug ---
# DEBUG_AGENTE=1

# Configurazione di Cippi Cam. Copia questo file in .env e modifica quello che ti serve.
# Senza .env si usano i valori di default: tutto in locale con Ollama.
# Le variabili impostate nella shell vincono su quelle del file.

# --- Database ---
# pg  → DATABASE_URL con utente e password (Docker, default)
# rds → RDS su AWS con token IAM: DB_HOST (+ DB_PORT, DB_NAME, DB_USER=diario). Si mette davanti al comando,
#       non qui: con DB_PROVIDER=rds nel .env anche il server locale userebbe il database su AWS.
DATABASE_URL=postgres://cippi:cippi@localhost:5432/cippi

# --- Modelli: quale provider ---
# ollama  → modelli in locale (default)
# bedrock → Amazon Bedrock; le credenziali le trova l'SDK AWS (aws sso login, ~/.aws/credentials, ruolo IAM)
LLM_PROVIDER=ollama

# --- Ollama ---
OLLAMA_URL=http://localhost:11434
VISION_MODEL=qwen3.5:9b
AGENT_MODEL=qwen3.5:9b
EMBED_MODEL=nomic-embed-text
EMBED_DIMENSIONI=768

# --- Bedrock (esempio: decommenta e scegli modelli abilitati sul tuo account e nella tua region) ---
# LLM_PROVIDER=bedrock
# AWS_REGION=eu-central-1
# VISION_MODEL=<id di un modello Bedrock con visione>
# AGENT_MODEL=<id di un modello Bedrock con tool use>
# AGENT_MODEL_RAGIONANTE=<opzionale: un modello più forte per i casi in cui scatta il guardrail>
# EMBED_MODEL=amazon.titan-embed-text-v2:0
# EMBED_DIMENSIONI=1024
# ⚠️ Gli embedding di un altro modello hanno un'altra dimensione e non sono confrontabili con quelli salvati:
#    cambiare EMBED_MODEL richiede una migrazione della colonna embedding_testo e il ricalcolo dei vettori.

# --- AWS (npm run carica, db:migra:aws, deploy:web, copia-correzioni) ---
# I valori li stampa: cd infra && terraform output -raw env_mac
# AWS_REGION=eu-south-1
# FOTO_BUCKET=cippi-cam-foto-<account>
# DB_HOST=cippi-cam-db.<id>.eu-south-1.rds.amazonaws.com
# DB_MASTER_SECRET_ARN=arn:aws:secretsmanager:eu-south-1:<account>:secret:rds!db-…   (lo legge solo db:migra:aws)
# WEB_BUCKET=cippi-cam-web-<account>
# CLOUDFRONT_ID=<id della distribuzione>

# --- Gabbia (acqua e cibo) ---
# Il controllo della gabbia è un secondo prompt: non gira a ogni foto, ma ogni GABBIA_OGNI_MIN minuti
# (tempo di scatto). Se l'ultimo controllo diceva "da_rifornire", si ricontrolla dopo GABBIA_RICONTROLLO_MIN.
# GABBIA_OGNI_MIN=20
# GABBIA_RICONTROLLO_MIN=5

# --- Debug ---
# DEBUG_AGENTE=1
